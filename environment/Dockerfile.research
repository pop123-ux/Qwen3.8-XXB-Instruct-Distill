FROM python:3.12.3-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /workspace/Qwen3.8-XXB-Instruct-Distill

RUN apt-get update \
    && apt-get install -y --no-install-recommends git git-lfs build-essential ca-certificates \
    && git lfs install --system \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/research-critical.txt /tmp/research-critical.txt

RUN python -m pip install --upgrade pip==25.2 \
    && python -m pip install --index-url https://download.pytorch.org/whl/cu128 torch==2.8.0 \
    && python -m pip install -r /tmp/research-critical.txt

COPY . .

CMD ["python", "scripts/research_guard.py", "--help"]
