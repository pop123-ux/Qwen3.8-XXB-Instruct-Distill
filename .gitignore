# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Model artifacts - never commit weights
*.safetensors
*.bin
*.gguf
*.pt
*.pth
*.ckpt
checkpoints/
models/

# Data
data/
*.jsonl.gz
*.parquet

# Experiment outputs: the lightweight records ARE the point, the bulk never is.
#
# `experiments/**/runs/` alone excluded the directory, and git cannot re-include a file
# whose parent directory is excluded — so every run record had to be `git add -f`'d, and
# one forgotten flag silently loses the write-up of an experiment that cost hours of GPU.
# Excluding the CONTENTS instead lets the summaries back in by name.
experiments/**/runs/**
!experiments/**/runs/**/
!experiments/**/runs/**/*.md
!experiments/**/runs/**/*.json
# ...and nothing heavy, whatever directory it turns up in.
experiments/**/*.pt
experiments/**/*.safetensors

# ... except a completed research run's trained adapters, which are its only irrecoverable
# output and go through Git LFS (see .gitattributes). The optimizer/scheduler/scaler/RNG
# state beside them stays excluded by the rules above: it exists to resume training.
!experiments/**/adapters/**/adapter_model.safetensors
experiments/**/*.bin
experiments/**/metrics.jsonl
# ...except in an archived run record, where the per-step metrics stream IS the evidence
# and is a few KB for a controlled run. Re-included by pattern rather than `git add -f`'d,
# for the reason given above: a forgotten flag loses the record. By pattern rather than by
# name because it was named for Run 001 alone, and the next run's record would have been
# silently dropped by a rule nobody thought to update.
!experiments/*/metrics.jsonl
evaluations/**/raw/
# Generations can be hundreds of MB; the summaries next to them are what we commit.
**/generations.jsonl
**/generations_*.jsonl
**/teacher_generations.jsonl
**/student_generations.jsonl
wandb/
*.log
# ...except an archived run's training log: tens of KB of the run's own stdout, and the
# only place its per-step console trace survives. Must come after `*.log`, because the
# last matching rule wins.
!experiments/*/training.log

# Local environment
.env
.env.*
.DS_Store
.idea/
.vscode/

# Vendored upstream metadata: supplied locally by each contributor, never
# redistributed through this repository (upstream content, upstream licence).
# The directory and its instructions are tracked; its contents are not.
vendor/qwen38-metadata/*
!vendor/qwen38-metadata/.gitkeep

# Level 2R corpus: reconstructed by scripts/prepare_level2r_dataset.py, never committed.
data/level2r/
data/*/train.txt
data/*/validation.txt

# Run output at the repository root. `experiments/**/runs/` above covers the
# historical layout; the GPU workflow writes to ./runs, which holds checkpoints,
# optimizer state and materialised students. Small JSON records worth keeping are
# copied into evaluations/ by hand.
/runs/
